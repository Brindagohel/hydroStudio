# MongoDB
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=hydrotest_db

# Number plate detection (paths are relative to the project root)
YOLO_MODEL_PATH=models/number_plate_model.pt
YOLO_CONFIDENCE=0.40
FRAME_SKIP=5

# Below this OCR confidence the UI asks the user to double-check the plate
OCR_MIN_CONFIDENCE=0.60

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100

# Hydrotest rules
DUE_SOON_DAYS=30
TEST_VALIDITY_DAYS=365

# Frontend origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# Vehicle details source: "mock" (built-in demo vehicles) or "http" (a real API)
VEHICLE_PROVIDER=mock
# For "http": the URL must contain {plate}, e.g. https://your-provider.example/v1/rc/{plate}
VEHICLE_API_URL=
VEHICLE_API_KEY=
VEHICLE_API_KEY_HEADER=Authorization
VEHICLE_API_TIMEOUT=10

# CNG cylinder re-test interval when a record has no next-due date (verify the rule for your region)
CNG_TEST_VALIDITY_YEARS=3
MAX_IMAGE_MB=10
